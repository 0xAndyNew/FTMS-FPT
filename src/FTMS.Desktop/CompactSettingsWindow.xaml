<Window x:Class="FTMS.Desktop.CompactSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C&#224;i &#273;&#7863;t" Width="480" Height="730" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F5F7" FontFamily="Segoe UI Variable Display">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#3A3A3C"/></Style>
        <Style x:Key="InputBox" TargetType="Control"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D8D8DC"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="13,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D3D3D8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#1D1D1F"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="C&#224;i &#273;&#7863;t th&#244;ng b&#225;o" FontSize="22" FontWeight="SemiBold" Foreground="#1D1D1F"/><TextBlock Text="Telegram, l&#224;m m&#7899;i danh s&#225;ch v&#224; kh&#7903;i &#273;&#7897;ng" Margin="0,4,0,0" FontSize="12" Foreground="#77777C"/></StackPanel>
            <Border Grid.Column="1" Width="38" Height="38" Background="#EAF2FF" CornerRadius="10"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16" Foreground="#326CA8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Border Padding="16" Background="#FFFFFF" BorderBrush="#E2E2E7" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Telegram" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F"/><TextBlock Text="Nh&#7853;n th&#244;ng b&#225;o khi ticket thay &#273;&#7893;i" FontSize="11" Foreground="#85858A" Margin="0,2,0,0"/></StackPanel>
                        <Button x:Name="TestTelegramButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="TestTelegram"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE724;" Margin="0,0,7,0"/><TextBlock Text="G&#7917;i th&#7917;"/></StackPanel></Button>
                    </Grid>
                    <TextBlock Text="Bot token" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/><PasswordBox x:Name="TokenBox" Style="{StaticResource InputBox}"/>
                    <TextBlock Text="Chat ID" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><TextBox x:Name="ChatIdBox" Style="{StaticResource InputBox}"/>
                    <TextBlock Text="HTTP proxy cho Telegram" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                    <TextBox x:Name="ProxyUrlBox" Style="{StaticResource InputBox}" ToolTip="Ví dụ: http://proxy.company:8080"/>
                    <TextBlock Text="Để trống nếu mạng không cần proxy. Định dạng: http://host:port" FontSize="11" Foreground="#85858A" Margin="0,5,0,0"/>
                    <Border x:Name="TestStatusPanel" Margin="0,12,0,0" Padding="10,7" Background="#F2F2F4" CornerRadius="6" Visibility="Collapsed"><TextBlock x:Name="TestStatusText" TextWrapping="Wrap" FontSize="11" Foreground="#5F5F64"/></Border>
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="16" Background="#FFFFFF" BorderBrush="#E2E2E7" BorderThickness="1" CornerRadius="10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="T&#7921; &#273;&#7897;ng l&#224;m m&#7899;i" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/><CheckBox x:Name="AutoRefreshCheck" Content="B&#7853;t l&#224;m m&#7899;i danh s&#225;ch FTMS" Margin="0,9,0,0" FontSize="12" Foreground="#454549"/><CheckBox x:Name="StartupCheck" Content="Kh&#7903;i &#273;&#7897;ng c&#249;ng Windows" Margin="0,9,0,0" FontSize="12" Foreground="#454549"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Chu k&#7923; (gi&#226;y)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RefreshSecondsBox" Style="{StaticResource InputBox}" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel>
                </Grid>
            </Border>
            <Border Margin="0,12,0,0" Padding="14,12" Background="#FFFFFF" BorderBrush="#E2E2E7" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FTMS Companion" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                            <TextBlock x:Name="AboutVersionLabel" Text=" v1.0.67" FontSize="12" Foreground="#6E6E73"/>
                        </StackPanel>
                        <TextBlock Text="FPT Telecom International • Phòng TOC Data Center" FontSize="11" Foreground="#85858A" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="OpenAbout" Height="30" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thông tin" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <TextBlock Margin="4,12,4,0" TextWrapping="Wrap" FontSize="11" Foreground="#77777C" Text="API th&#7901;i gian th&#7921;c v&#7851;n ho&#7841;t &#273;&#7897;ng li&#234;n t&#7909;c. T&#7921; &#273;&#7897;ng l&#224;m m&#7899;i ch&#7881; b&#7845;m n&#250;t T&#7843;i l&#7841;i c&#7911;a danh s&#225;ch FTMS, kh&#244;ng t&#7843;i l&#7841;i to&#224;n trang."/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Token &#273;&#432;&#7907;c m&#227; h&#243;a b&#7857;ng Windows DPAPI" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="H&#7911;y" Click="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="L&#432;u c&#224;i &#273;&#7863;t" Click="Save" Height="34" Padding="16,0" Background="#1D1D1F" Foreground="White" BorderThickness="0" Cursor="Hand"/></StackPanel>
        </Grid>
    </Grid>
</Window>
