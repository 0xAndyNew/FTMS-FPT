<Window x:Class="FTMS.Desktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin ứng dụng - FTMS Companion" Width="500" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F5F7" FontFamily="Segoe UI Variable Display"
        Icon="pack://application:,,,/ftms-app.ico">
    <Window.Resources>
        <Style x:Key="FeatureTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
        <Style x:Key="FeatureDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6E6E73"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,2,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="50" Height="50" Background="#FFFFFF" BorderBrush="#E2E2E7" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0">
                <Image Source="pack://application:,,,/ftms-app.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FTMS Companion" FontSize="20" FontWeight="SemiBold" Foreground="#1D1D1F" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="8,2" Background="#EAF2FF" CornerRadius="6" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v1.0.67" FontSize="11" FontWeight="SemiBold" Foreground="#1A5EB8"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="FPT Telecom International • Phòng TOC Data Center" FontSize="11" Foreground="#77777C" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Body / Content -->
        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Overview card -->
                <Border Padding="16" Background="#FFFFFF" BorderBrush="#E2E2E7" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Tổng quan hệ thống" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#4A4A4E" LineHeight="18"
                                   Text="FTMS Companion là ứng dụng chuyên dụng phục vụ kỹ thuật viên phòng TOC Data Center (FPT Telecom International), cung cấp khả năng giám sát ticket FTMS theo thời gian thực, hiển thị bảng điều khiển cá nhân hóa HUD và hỗ trợ nhận ticket 2 chiều từ xa qua Telegram."/>
                    </StackPanel>
                </Border>

                <!-- Features card -->
                <Border Margin="0,12,0,0" Padding="16" Background="#FFFFFF" BorderBrush="#E2E2E7" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Tính năng cốt lõi" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,12"/>

                        <!-- Feature 1 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE7BA;" Foreground="#D96B3B"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FeatureTitle}" Text="Giám sát thời gian thực &amp; Cảnh báo SLA"/>
                                <TextBlock Style="{StaticResource FeatureDesc}" Text="Phát hiện tức thì ticket mới, chuyển giao, đổi trạng thái và cảnh báo các mốc sắp quá hạn SLA (5, 3, 1 phút)."/>
                            </StackPanel>
                        </Grid>

                        <!-- Feature 2 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE9D2;" Foreground="#2A78D6"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FeatureTitle}" Text="Bảng điều khiển HUD cá nhân hóa"/>
                                <TextBlock Style="{StaticResource FeatureDesc}" Text="Tự động nhận diện tài khoản kỹ thuật viên, theo dõi khối lượng ticket mở/đóng trong ngày theo giờ Việt Nam."/>
                            </StackPanel>
                        </Grid>

                        <!-- Feature 3 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE724;" Foreground="#1BAF7A"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FeatureTitle}" Text="Nhận ticket 2 chiều từ xa qua Telegram"/>
                                <TextBlock Style="{StaticResource FeatureDesc}" Text="Tiếp nhận ticket trực tiếp qua nút bấm Telegram, tự động chuyển trạng thái Hỗ trợ KH cho ticket dạng RQ."/>
                            </StackPanel>
                        </Grid>

                        <!-- Feature 4 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE895;" Foreground="#8944AB"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FeatureTitle}" Text="Đồng bộ tức thì &amp; Khôi phục phiên"/>
                                <TextBlock Style="{StaticResource FeatureDesc}" Text="Bắt sự kiện đổi trạng thái trên web để đồng bộ ngay lập tức và tự động khôi phục đăng nhập SSO ADFS khi hết hạn."/>
                            </StackPanel>
                        </Grid>

                        <!-- Feature 5 -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE72E;" Foreground="#4B6A9B"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FeatureTitle}" Text="Phân lập dữ liệu đa tài khoản &amp; Bảo mật DPAPI"/>
                                <TextBlock Style="{StaticResource FeatureDesc}" Text="Lưu trữ SQLite WAL độc lập theo UserId, mã hóa mật khẩu và token bằng Windows Data Protection API."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Copyright © 2026 FPT Telecom International" FontSize="11" Foreground="#6E6E73"/>
                <TextBlock Text="Phòng TOC Data Center • All rights reserved." FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="Đóng" Click="CloseButton_Click" Height="34" Padding="20,0" HorizontalAlignment="Right"
                    Background="#1D1D1F" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
