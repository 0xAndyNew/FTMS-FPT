<Window x:Class="FTMS.Desktop.CompactWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FTMS Companion" Icon="pack://application:,,,/ftms-app.ico" Width="1280" Height="760" MinWidth="900" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Segoe UI Variable Display" PreviewMouseDown="OnUserActivity" PreviewMouseWheel="OnUserActivity" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniCopyButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="MonitorWebView" Width="1" Height="1" IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="-1"/>

        <!-- Header Surface (White, 56px height, compact & clean) -->
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Toolbar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="Trang chính (Danh sách hỗ trợ)" Click="OpenFtms">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="14" Foreground="#1F2937"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Làm mới trang hiện tại (F5)" Click="ReloadFtms">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="14" Foreground="#1F2937"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Cài đặt hệ thống" Click="OpenSettings">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="14" Foreground="#1F2937"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Thông tin ứng dụng (About)" Click="OpenAbout">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="14" Foreground="#1F2937"/>
                    </Button>
                    <Border Margin="6,0,0,0" Padding="8,4" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#D9A441" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SessionText" Text="Đang kết nối" FontSize="11" FontWeight="Medium" Foreground="#166534"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Dashboard Telemetry Card (Responsive, Stretches smoothly) -->
                <Border x:Name="DashboardCard" Grid.Column="1" HorizontalAlignment="Right" MinWidth="480" MaxWidth="720" Height="46"
                        Padding="8,3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center"
                        AutomationProperties.Name="Đang tải thông tin dashboard">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto" MinWidth="105"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. Ticket Mới -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,8,0">
                            <TextBlock Text="TICKET MỚI" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="GlobalNewValue" Text="0" FontSize="16" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#E5E7EB" Margin="0,3"/>

                        <!-- 2. Công việc cá nhân (Flex width *) -->
                        <Grid Grid.Column="2" Margin="10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="23"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CÔNG VIỆC CỦA" FontSize="9" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentUserName" Grid.Column="1" Text="Đang nhận diện…" Margin="5,0,6,0" FontSize="10" FontWeight="SemiBold" Foreground="#111827" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Mở " FontSize="9" Foreground="#6B7280"/>
                                    <TextBlock x:Name="PersonalTotalValue" Text="—" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#2563EB" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PersonalAssignedValue" Text="—" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                    </StackPanel>
                                    <TextBlock Text="Phân công" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#059669" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PersonalInProgressValue" Text="—" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                    </StackPanel>
                                    <TextBlock Text="Đang làm" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#D97706" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PersonalPausedValue" Text="—" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                    </StackPanel>
                                    <TextBlock Text="Tạm ngưng" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PersonalClosedTodayValue" Text="—" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                    </StackPanel>
                                    <TextBlock Text="Đóng hôm nay" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <Border Grid.Column="3" Background="#E5E5EB" Margin="0,3"/>

                        <!-- 3. SLA -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="SLA CỦA TÔI" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#EAB308" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SlaRiskValue" Text="0" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                    </StackPanel>
                                    <TextBlock Text="Sắp hạn" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#DC2626" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SlaViolatedValue" Text="0" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                                    </StackPanel>
                                    <TextBlock Text="Quá hạn" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main WebView2 Area -->
        <Grid Grid.Row="1" Margin="8,6,8,6">
            <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                <wv2:WebView2 x:Name="FtmsWebView" NavigationCompleted="OnNavigationCompleted"/>
            </Border>
        </Grid>

        <!-- Bottom Log & Status Bar (White, Responsive, Full Tooltip & Copy) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Log Badge -->
                <Border Grid.Column="0" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LOG" FontSize="9" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Center: Flexible MonitorText, expands across window, trims with ellipsis, shows full tooltip, click-to-copy -->
                <TextBlock x:Name="MonitorText" Grid.Column="1" Text="Đang khởi tạo…"
                           Foreground="#374151" VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                           ToolTipService.ShowDuration="25000" ToolTipService.InitialShowDelay="100"
                           PreviewMouseLeftButtonUp="OnMonitorTextClick">
                    <TextBlock.ToolTip>
                        <ToolTip Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10,8" HasDropShadow="True">
                            <StackPanel MaxWidth="600">
                                <TextBlock Text="Thông tin nhật ký hệ thống:" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Text, ElementName=MonitorText}" TextWrapping="Wrap" FontSize="12" Foreground="#111827" LineHeight="17"/>
                                <Border Margin="0,6,0,0" Padding="0,4,0,0" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0">
                                    <TextBlock Text="💡 Bấm chuột vào dòng log để sao chép vào bộ nhớ tạm (Clipboard)" FontSize="10" Foreground="#9CA3AF"/>
                                </Border>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>

                <!-- Right: Copy Button & Realtime Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource MiniCopyButton}" ToolTip="Sao chép toàn bộ dòng log" Click="CopyLogToClipboard" Margin="0,0,6,0">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" FontSize="11" Foreground="#6B7280"/>
                    </Button>
                    <Border Background="#F3F4F6" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" FontSize="10" Foreground="#6B7280" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="THỜI GIAN THỰC • TỰ ĐỘNG LÀM MỚI" Foreground="#6B7280" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
