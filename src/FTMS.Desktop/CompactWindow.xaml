<Window x:Class="FTMS.Desktop.CompactWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FTMS Companion" Icon="pack://application:,,,/ftms-app.ico" Width="1280" Height="760" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#F5F5F7" FontFamily="Segoe UI Variable Display" PreviewMouseDown="OnUserActivity" PreviewMouseWheel="OnUserActivity" PreviewKeyDown="OnUserActivity">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E1E1E5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTipService.ShowDuration" Value="5000"/></Style>
        <Style x:Key="ChartValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1D1D1F"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
        <Style x:Key="ChartLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="Foreground" Value="#6E6E73"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <wv2:WebView2 x:Name="MonitorWebView" Width="1" Height="1" IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="-1"/>
        <Border Background="#FBFBFD" BorderBrush="#E1E1E5" BorderThickness="0,0,0,1">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="Trang chính (Danh sách hỗ trợ)" Click="OpenFtms"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="16" Foreground="#1D1D1F"/></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Làm mới trang hiện tại (F5)" Click="ReloadFtms"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="16" Foreground="#1D1D1F"/></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Cài đặt" Click="OpenSettings"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16" Foreground="#1D1D1F"/></Button>
                    <Border Margin="8,0,0,0" Padding="10,6" Background="#EEF4F0" CornerRadius="6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#D9A441" Margin="0,0,7,0"/><TextBlock x:Name="SessionText" Text="Đang kết nối" FontSize="11" Foreground="#53605B"/></StackPanel></Border>
                </StackPanel>
                <Border x:Name="DashboardCard" Grid.Column="2" Width="660" Height="64" Padding="10,5" Background="#FFFFFF" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center"
                        AutomationProperties.Name="Đang tải thông tin dashboard">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="TICKET MỚI" FontSize="10" FontWeight="SemiBold" Foreground="#52514E"/>
                            <TextBlock x:Name="GlobalNewValue" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tất cả" FontSize="10" Foreground="#898781" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E5E5EA" Margin="0,2"/>
                        <Grid Grid.Column="2" Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="33"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="CÔNG VIỆC CỦA" FontSize="10" FontWeight="SemiBold" Foreground="#52514E" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentUserName" Grid.Column="1" Text="Đang nhận diện…" Margin="5,0,8,0" FontSize="11" FontWeight="SemiBold" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Đang mở " FontSize="10" Foreground="#898781"/><TextBlock x:Name="PersonalTotalValue" Text="—" FontSize="11" FontWeight="Bold" Foreground="#1D1D1F"/></StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="1" Columns="4">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#2A78D6" Margin="0,0,5,0"/><TextBlock x:Name="PersonalAssignedValue" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/></StackPanel><TextBlock Text="Phân công" FontSize="10" Foreground="#52514E" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#1BAF7A" Margin="0,0,5,0"/><TextBlock x:Name="PersonalInProgressValue" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/></StackPanel><TextBlock Text="Đang thực hiện" FontSize="10" Foreground="#52514E" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#EB6834" Margin="0,0,5,0"/><TextBlock x:Name="PersonalPausedValue" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/></StackPanel><TextBlock Text="Tạm ngưng" FontSize="10" Foreground="#52514E" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#0CA30C" Margin="0,0,5,0"/><TextBlock x:Name="PersonalClosedTodayValue" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/></StackPanel><TextBlock Text="Đã đóng hôm nay" FontSize="10" Foreground="#52514E" HorizontalAlignment="Center"/></StackPanel>
                            </UniformGrid>
                        </Grid>
                        <Border Grid.Column="3" Background="#E5E5EA" Margin="0,2"/>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="SLA CỦA TÔI" FontSize="10" FontWeight="SemiBold" Foreground="#52514E" HorizontalAlignment="Center"/>
                            <UniformGrid Columns="2" Margin="0,3,0,0">
                                <StackPanel HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#FAB219" Margin="0,0,5,0"/><TextBlock x:Name="SlaRiskValue" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F"/></StackPanel><TextBlock Text="Sắp hạn" FontSize="10" Foreground="#52514E"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#D03B3B" Margin="0,0,5,0"/><TextBlock x:Name="SlaViolatedValue" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F"/></StackPanel><TextBlock Text="Quá hạn" FontSize="10" Foreground="#52514E"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="10"><Border Background="White" BorderBrush="#DEDEE2" BorderThickness="1" CornerRadius="8"><wv2:WebView2 x:Name="FtmsWebView" NavigationCompleted="OnNavigationCompleted"/></Border></Grid>
        <Border Grid.Row="2" Background="#1D1D1F"><Grid Margin="14,0"><TextBlock x:Name="MonitorText" Text="Đang khởi tạo" Foreground="#D2D2D7" VerticalAlignment="Center" FontSize="10"/><TextBlock Text="THỜI GIAN THỰC + TỰ ĐỘNG LÀM MỚI" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9"/></Grid></Border>
    </Grid>
</Window>
